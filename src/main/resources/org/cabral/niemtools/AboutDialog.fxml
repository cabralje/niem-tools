<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cabral.niemtools.AboutDialogController">
    <children>
        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="NIEM Tools" />
        <Label style="-fx-font-size: 12; -fx-text-fill: #666666;" text="A tool for NIEM UML modeling" />
        <Label minHeight="-Infinity" text="NIEM Tools is a Java application that provides utilities for working with the National Information Exchange Model (NIEM) using UML modeling." wrapText="true" />
        <HBox minHeight="-Infinity" minWidth="-Infinity" spacing="10.0">
            <children>
                <Label text="Version:" />
                <Label fx:id="versionLabel" text="1.0.0" />
            </children>
        </HBox>
        <VBox prefHeight="35.0" prefWidth="360.0" spacing="5.0">
            <children>
                <Label style="-fx-font-weight: bold;" text="License:" />
                <Label text="Licensed under the GPL-3.0" wrapText="true" />
            </children>
        </VBox>
        <HBox alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="360.0" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#closeDialog" text="Close" />
            </children>
        </HBox>
    </children>
</VBox>
