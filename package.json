{
  "name": "niem-tools",
  "version": "2.0.0",
  "description": "This is a BOUML plugout that supports developing NIEM message specifications in UML.",
  "bin": {
    "niem-tools": "jdeploy-bundle/jdeploy.js"
  },
  "preferGlobal": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cabralje/niem-tools.git"
  },
  "keywords": ["niem", "uml", "bouml", "xml", "schema"],
  "author": "Jim Cabral <jim@cabral.org>",
  "license": "ISC",
  "devDependencies": {
    "jdeploy": "^5.5.15"
  },
  "jdeploy": {
    "jdk": 21,
    "javafx": true,
    "jar": "target/niemtools-2.0.jar",
    "mainClass": "org.cabral.niemtools.BoumlPlugout",
    "title": "NIEM Tools",
    "description": "A BOUML plugout for developing NIEM message specifications",
    "files": [
      "bouml-templates"
    ]
  },
  "files": [
    "jdeploy-bundle",
    "bouml-templates"
  ]
}
