{
    "configurations": [
                {
            "name": "Launch NIEMTools",
            "type": "java",
            "request": "launch",
            "mainclass": "org.cabral.niemtools.BoumlPlugout",
            "sourcePaths": ["${workspaceFolder}/src/main/java"],
            "classPaths": ["${workspaceFolder}/target/classes",
                            "${workspaceFolder}/target/*"],
            "args": ""
        },
        {
            "name": "Generate specification",
            "type": "java",
            "request": "launch",
            "mainclass": "org.cabral.niemtools.BoumlPlugout",
            "sourcePaths": ["${workspaceFolder}/src/main/java"],
            "classPaths": ["${workspaceFolder}/target/classes",
                            "${workspaceFolder}/target/*"],
            "args": "publishSpecification"
        },
        {
            "name": "Publish UML",
            "type": "java",
            "request": "launch",
            "mainclass": "org.cabral.niemtools.BoumlPlugout",
            "sourcePaths": ["${workspaceFolder}/src/main/java"],
            "classPaths": ["${workspaceFolder}/target/classes",
                            "${workspaceFolder}/target/*"],
            "args": "publishUML"
        },
                {
            "name": "Import mapping",
            "type": "java",
            "request": "launch",
            "mainclass": "org.cabral.niemtools.BoumlPlugout",
            "sourcePaths": ["${workspaceFolder}/src/main/java"],
